# Copy to .env.local for local development. Next.js reads .env.local itself;
# only variables prefixed NEXT_PUBLIC_ reach code that runs in the browser.

# Where the API is. The backend also has to list this app's origin in
# AUTOTRAIN_CORS_ORIGINS and point AUTOTRAIN_APP_BASE_URL back at it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
