; ARCHITECTURE §3's boundary rules, made mechanical. Run from backend/ with:
;   lint-imports        (or: uv run lint-imports)

[importlinter]
root_package = autotrain
; External packages appear in the graph (squashed to their top-level name) so
; the driver-containment contract below can see psycopg; contracts over
; internal modules are unaffected.
include_external_packages = True

; --- Module privacy ---------------------------------------------------------
; Modules talk to each other only through their service layer. Privacy is one
; contract PER MODULE, because a blanket source of autotrain.modules would
; forbid a module importing its own internals. Adding module M means:
;   1. add an "<M>-privacy" contract: source_modules = api, entrypoints and
;      every OTHER module; forbidden_modules = M's non-service files;
;   2. add M to source_modules of every existing *-privacy contract —
;      otherwise M may import its siblings' internals with CI green.
; allow_indirect_imports: reaching repository/models THROUGH the service is the
; sanctioned path — only a direct import is a boundary breach.
[importlinter:contract:journeys-privacy]
name = journeys internals are importable only via journeys.service
type = forbidden
source_modules =
    autotrain.api
    autotrain.entrypoints
    autotrain.modules.claims
    autotrain.modules.delays
    autotrain.modules.identity
    autotrain.modules.notifications
    autotrain.sources
forbidden_modules =
    autotrain.modules.journeys.models
    autotrain.modules.journeys.repository
allow_indirect_imports = True

[importlinter:contract:delays-privacy]
name = delays internals are importable only via delays.service
type = forbidden
source_modules =
    autotrain.api
    autotrain.entrypoints
    autotrain.modules.claims
    autotrain.modules.identity
    autotrain.modules.journeys
    autotrain.modules.notifications
    autotrain.sources

forbidden_modules =
    autotrain.modules.delays.models
    autotrain.modules.delays.repository
allow_indirect_imports = True

[importlinter:contract:claims-privacy]
name = claims internals are importable only via claims.service
type = forbidden
source_modules =
    autotrain.api
    autotrain.entrypoints
    autotrain.modules.delays
    autotrain.modules.identity
    autotrain.modules.journeys
    autotrain.modules.notifications
    autotrain.sources
forbidden_modules =
    autotrain.modules.claims.adapters
    autotrain.modules.claims.models
    autotrain.modules.claims.repository
allow_indirect_imports = True

; notifications has no privacy contract yet, deliberately: the module owns no
; tables and so has no models.py or repository.py to protect. The contract
; appears with the first migration that gives it state.
[importlinter:contract:identity-privacy]
name = identity internals are importable only via identity.service
type = forbidden
source_modules =
    autotrain.api
    autotrain.entrypoints
    autotrain.modules.claims
    autotrain.modules.delays
    autotrain.modules.journeys
    autotrain.modules.notifications
    autotrain.sources
forbidden_modules =
    autotrain.modules.identity.models
    autotrain.modules.identity.repository
allow_indirect_imports = True

[importlinter:contract:api-does-not-import-repositories]
name = api delegates to services, never to repositories
type = forbidden
source_modules =
    autotrain.api
forbidden_modules =
    autotrain.modules.journeys.repository
    autotrain.modules.delays.repository
    autotrain.modules.claims.repository
    autotrain.modules.identity.repository
allow_indirect_imports = True

; --- Layer direction --------------------------------------------------------
[importlinter:contract:core-knows-nothing-of-domain]
name = core is domain-free plumbing
type = forbidden
source_modules =
    autotrain.core
forbidden_modules =
    autotrain.modules
    autotrain.api
    autotrain.entrypoints
    autotrain.sources

[importlinter:contract:modules-do-not-import-api]
name = modules never reach up into api or entrypoints
type = forbidden
source_modules =
    autotrain.modules
forbidden_modules =
    autotrain.api
    autotrain.entrypoints

; The delay engine defines the ArrivalsSource protocol; concrete transports
; implement it from outside. If a module imported a source, the engine would
; be married to one transport and the protocol would be theatre.
[importlinter:contract:modules-do-not-import-sources]
name = modules stay source-agnostic
type = forbidden
source_modules =
    autotrain.modules
forbidden_modules =
    autotrain.sources

; ...and sources are constructed BY entrypoints, never the reverse: a source
; reaching up would invert the layering and invite circular imports.
[importlinter:contract:sources-do-not-reach-up]
name = sources never import api or entrypoints
type = forbidden
source_modules =
    autotrain.sources
forbidden_modules =
    autotrain.api
    autotrain.entrypoints

; --- Driver containment -----------------------------------------------------
; psycopg stays behind core/ and module services — the reason core.db
; re-exports Connection. The indirect chain api -> core.db -> psycopg is the
; sanctioned path; a direct import (e.g. catching pg_errors in a router) is
; the breach this catches.
[importlinter:contract:psycopg-stays-behind-core]
name = api, entrypoints and sources never import psycopg directly
type = forbidden
source_modules =
    autotrain.api
    autotrain.entrypoints
    autotrain.sources
forbidden_modules =
    psycopg
    psycopg_pool
allow_indirect_imports = True
