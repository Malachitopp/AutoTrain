# Copy to .env for local development. Every setting is read from the environment
# with the AUTOTRAIN_ prefix; nothing is ever read from a config file at runtime.
# 'production' refuses to boot while any development setting is still in
# place: a short JWT secret, a 'log' transport, an http origin, an insecure
# cookie (core/config.py, _production_lockdown).
AUTOTRAIN_ENVIRONMENT=local
# Port 5433 — the docker-compose Postgres. 5432 is left alone in case a Postgres
# is installed natively on the host.
AUTOTRAIN_DATABASE_URL=postgresql://autotrain:autotrain@localhost:5433/autotrain
AUTOTRAIN_LOG_LEVEL=INFO

# Integration tests drop and recreate this database on every run.
# Never point it at anything you care about.
AUTOTRAIN_TEST_DATABASE_URL=postgresql://autotrain:autotrain@localhost:5433/autotrain_test

# Ingestor: which arrivals source feeds the delay sweep. 'none' (default)
# refuses to start. 'hsp' needs a free Rail Data Portal account
# (https://raildata.org.uk — subscribe to Historical Service Performance).
#AUTOTRAIN_ARRIVALS_SOURCE=hsp
#AUTOTRAIN_HSP_EMAIL=you@example.com
#AUTOTRAIN_HSP_PASSWORD=change-me

# Worker: which push sender delivers notifications. 'none' (default) refuses
# to start; 'log' writes deliveries to the process log — the development
# transport until FCM/APNs arrive with the app.
#AUTOTRAIN_PUSH_SENDER=log

# Auth: which email sender delivers magic-link logins. 'none' (default) makes
# the /auth/login/request endpoint refuse; 'log' writes the email to the
# process log — in development the log is the inbox, and production refuses
# to boot with it. 'resend' delivers for real through https://resend.com,
# whose free tier sends 3,000 emails a month with no card.
#AUTOTRAIN_EMAIL_SENDER=log
#
# For 'resend': an API key from the Resend dashboard, and the address every
# email is sent as. The From domain must be verified with Resend first (it
# gives you the SPF, DKIM and DMARC records to add), or every send is
# refused with HTTP 403. Verify a SUBDOMAIN — in.example.com, not
# example.com — so the records never touch the mail on your main domain.
#AUTOTRAIN_RESEND_API_KEY=re_...
#AUTOTRAIN_EMAIL_FROM=AutoTrain <login@in.example.com>

# Login rate limits. /auth/login/request is the only unauthenticated endpoint
# that spends money, so three caps bound what a stranger with a loop can cost.
# Per address per rolling 24h — stops one inbox being filled with our mail.
#AUTOTRAIN_LOGIN_REQUESTS_PER_EMAIL_PER_DAY=5
# Across everyone per rolling 24h. Keep it under the provider's own ceiling
# (Resend's free tier is 100/day): hitting ours costs a 429, hitting theirs
# costs refused sends and a provider that starts judging the account.
#AUTOTRAIN_LOGIN_REQUESTS_PER_DAY=80
# Per calling address per hour, held in the API process's memory. The only
# cap that catches one caller working through many different addresses.
#AUTOTRAIN_LOGIN_REQUESTS_PER_IP_PER_HOUR=20
# How long a spent login token is kept before the scheduler deletes it. The
# purge never reaches inside the 24h rate-limit window whatever this says.
#AUTOTRAIN_LOGIN_TOKEN_RETENTION_DAYS=7

# Signing key for session JWTs — whoever holds it can mint a session for any
# user, so generate a long random value and never commit a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#AUTOTRAIN_JWT_SECRET=change-me

# Browser origins allowed to call the API (CORS). A JSON list — brackets and
# double quotes included — because the setting is list-typed.
#AUTOTRAIN_CORS_ORIGINS=["http://localhost:3000"]

# The frontend origin magic links point at; the link is <base>/login?token=...
#AUTOTRAIN_APP_BASE_URL=http://localhost:3000

# Ticket-email intake. Users forward booking emails to tickets-<code>@<domain>;
# the mail provider posts each one to POST /intake/email with the shared
# secret in the X-AutoTrain-Intake-Secret header. The scheduler reads queued
# emails with the configured reader: 'none' (default) skips the job; 'claude'
# needs an Anthropic API key. Generate the secret like the JWT one.
#AUTOTRAIN_INBOUND_EMAIL_DOMAIN=in.autotrain.app
#AUTOTRAIN_INTAKE_SECRET=change-me
#AUTOTRAIN_TICKET_EXTRACTOR=claude
#AUTOTRAIN_ANTHROPIC_API_KEY=sk-ant-...
# The intake door's per-user cap (emails stored per rolling 24 hours) and how
# many days a decided email's raw body is kept before the scheduler blanks it.
#AUTOTRAIN_INTAKE_DAILY_CAP=50
#AUTOTRAIN_INTAKE_BODY_RETENTION_DAYS=60

# Logs: 'text' for a terminal (default), 'json' for a log store. Every line
# carries the process name and, in the API, the request id the client got
# back as X-Request-ID.
#AUTOTRAIN_LOG_FORMAT=json

# The web session cookie's Secure flag. Leave unset (false) for a local http
# server; set true in every https deployment.
#AUTOTRAIN_SESSION_COOKIE_SECURE=true
