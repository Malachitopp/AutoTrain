# Copy to .env for local development. Every setting is read from the environment
# with the AUTOTRAIN_ prefix; nothing is ever read from a config file at runtime.
AUTOTRAIN_ENVIRONMENT=local
# Port 5433 — the docker-compose Postgres. 5432 is left alone in case a Postgres
# is installed natively on the host.
AUTOTRAIN_DATABASE_URL=postgresql://autotrain:autotrain@localhost:5433/autotrain
AUTOTRAIN_LOG_LEVEL=INFO

# Integration tests drop and recreate this database on every run.
# Never point it at anything you care about.
AUTOTRAIN_TEST_DATABASE_URL=postgresql://autotrain:autotrain@localhost:5433/autotrain_test

# Ingestor: which arrivals source feeds the delay sweep. 'none' (default)
# refuses to start. 'hsp' needs a free Rail Data Portal account
# (https://raildata.org.uk — subscribe to Historical Service Performance).
#AUTOTRAIN_ARRIVALS_SOURCE=hsp
#AUTOTRAIN_HSP_EMAIL=you@example.com
#AUTOTRAIN_HSP_PASSWORD=change-me

# Worker: which push sender delivers notifications. 'none' (default) refuses
# to start; 'log' writes deliveries to the process log — the development
# transport until FCM/APNs arrive with the app.
#AUTOTRAIN_PUSH_SENDER=log
